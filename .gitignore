# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# test / lint cache
.vitest
.eslintcache

# downloaded raw data cache (dev-time only)
.cache/

# high-resolution PNG source images (437 MB, dev-time only — WebP in public/ is committed)
/assets/creatures-source/

# 2nd-gen evolved source images (dev-time only, local-only — same convention as 1st-gen source)
/assets/creatures-gen2-source/

# scratch comparison/debug artifacts
/scripts/.gen2-compare/
/scripts/.make-comparison.mjs

# favicon design candidates (scratch; pick one then clean up)
/assets/favicon-candidates/

# site mascot source image (1.6 MB, dev-time only — derived icon.png/logo.png are committed)
/d66bb9e0-2d96-48fe-a2d5-3b3faa983379.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

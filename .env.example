# ---------------------------------------------------------------------------
# Environment variables — EXAMPLE ONLY. Copy to .env.local for local values.
# .env.local is git-ignored. Do NOT commit real secrets.
# ---------------------------------------------------------------------------

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX").
# Public by design — NEXT_PUBLIC_* is inlined into the client bundle at build time.
# Set ONLY in the Cloudflare Pages Production build. Leave empty for local and
# Preview builds so no events are sent to the production GA property.
NEXT_PUBLIC_GA_ID=
